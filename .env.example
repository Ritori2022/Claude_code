# Luna多平台聊天桥接配置示例
# 复制此文件为 .env 并填入真实配置

# ============ Claude API ============
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============ QQ Bot (NapCat) ============
QQ_ONEBOT_URL=http://localhost:3000
QQ_ONEBOT_SECRET=your_onebot_secret
# 监听的QQ群（逗号分隔）
QQ_GROUPS=123456789,987654321
# 监听的QQ好友（逗号分隔）
QQ_FRIENDS=

# ============ iMessage ============
# 启用iMessage桥接 (true/false)
IMESSAGE_ENABLED=false
# iMessage REST API地址（如果使用imessage-rest）
IMESSAGE_API_URL=http://localhost:3001
# 监听的联系人（逗号分隔）
IMESSAGE_CONTACTS=+1234567890,friend@icloud.com

# ============ 其他配置 ============
# Luna响应触发词（正则表达式）
LUNA_TRIGGER=luna|Luna|露娜
# 日志级别
LOG_LEVEL=info
